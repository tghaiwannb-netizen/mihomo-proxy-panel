# mihomo-hub 配置（复制为 hub.env，权限 600）
AUTH_BASE_URL=https://auth.jizhang.org
AUTH_CLIENT_ID=mihomo-panel
AUTH_CLIENT_SECRET=REPLACE_ME
# 多个域名用逗号分隔，第一个为主域名；每个都要在 auth 客户端里登记回调
PUBLIC_URL=https://acis-vpn.jizhang.org,https://mihomo.jizhang.org
# 管理员邮箱，多个用逗号分隔
ADMIN_EMAILS=tg.haiwan.nb@gmail.com
HUB_HOST=127.0.0.1
HUB_PORT=8097
DATA_DIR=/opt/mihomo-hub/data
# 放进这个目录的文件都会下发给管理员的控制台（config.yaml、mihomo-windows-amd64.exe 等）
FILES_DIR=/opt/mihomo-hub/files
TOKEN_DAYS=30
PACKAGES_DIR=/opt/mihomo-hub/packages
WEB_HOURS=72
